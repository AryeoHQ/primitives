{
    "name": "aryeo/primitives",
    "description": "A package of primitives used to transform data into reusable objects.",
    "keywords": [
        "Aryeo",
        "laravel",
        "actions"
    ],
    "homepage": "https://github.com/aryeohq/primitives",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rob Fonseca",
            "email": "robfo@zillowgroup.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-filter": "*",
        "ext-bcmath": "*",
        "laravel/framework": "^12.0",
        "nesbot/carbon": "^3.10"
    },
    "require-dev": {
        "aryeo/tooling-laravel": "^0.0.2",
        "brianium/paratest": "^7.0",
        "orchestra/testbench": "^10.0.0",
        "orchestra/testbench-core": "^10.0.0",
        "phpunit/phpunit": "^12"
    },
    "repositories": {
        "tooling-laravel": {
            "type": "vcs",
            "url": "https://github.com/AryeoHQ/tooling-laravel"
        }
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/Support/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "aryeo/tooling-laravel": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
