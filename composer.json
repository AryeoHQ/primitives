{
    "name": "aryeo/primitives",
    "description": "A package of primitives used to transform data into reusable objects.",
    "keywords": [
        "Aryeo",
        "laravel",
        "actions"
    ],
    "homepage": "https://github.com/aryeohq/primitives",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rob Fonseca",
            "email": "robfo@zillowgroup.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-filter": "*",
        "ext-bcmath": "*",
        "laravel/framework": "^12.36 || ^13",
        "nesbot/carbon": "^3.10"
    },
    "require-dev": {
        "aryeo/tooling-laravel": "0.0.41",
        "brianium/paratest": "^7.14",
        "orchestra/testbench": "^10.6 || ^11",
        "orchestra/testbench-core": "^10.7 || ^11",
        "phpunit/phpunit": "^12 || ^13"
    },
    "repositories": {
        "artifactory": {
            "type": "composer",
            "url": "https://artifactory.zgtools.net/artifactory/api/composer/listing-and-vendor-management-composer/",
            "only": ["aryeo/*", "zillow/*"]
        }
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/Support/"
        },
        "exclude-from-classmap": [
            "*Test.php",
            "*TestCases.php",
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "extra": {
        "tooling": {
            "phpstan": {
                "config": {
                    "paths": [
                        "src"
                    ]
                }
            },
            "rector": {
                "config": {
                    "paths": [
                        "src",
                        "tests"
                    ]
                }
            },
            "pint": {
                "config": {
                    "paths": [
                        "src",
                        "tests"
                    ]
                }
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "aryeo/tooling-laravel": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
